# Copy to .env.local for local development.
# In production, set these in your host's environment (e.g. Vercel project settings).

# Convex deployment URL (Dashboard → Settings → Deployment URL)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Marketing site this form links back to.
# prod: https://hackuta.org   dev: https://dev.hackuta.org
VITE_LANDING_URL=https://hackuta.com/

# Convex CLI deployment selector (local development/CI only)
CONVEX_DEPLOYMENT=

# Convex Auth site URL (the https://<deployment>.convex.site URL)
CONVEX_SITE_URL=

# Set only in the deployment environment; never expose as VITE_*.
CONVEX_AUTH_TOKEN=

REGISTRATION_TOKEN_SECRET=

# Set on the Convex deployment (not Vite). Comma-separated browser origins
# allowed to upload resumes. SITE_URL on Convex also adds its origin automatically.
# Example: npx convex env set REGISTRATION_ALLOWED_ORIGINS "http://127.0.0.1:5273,http://localhost:5273"
REGISTRATION_ALLOWED_ORIGINS=

# Comma-separated Convex Auth tokenIdentifier values allowed to list hackathon
# registrations, e.g. organizer accounts synced through Convex Auth.
REGISTRATION_ADMIN_IDENTITY_KEYS=

# Test builds only. Keep false for real local and production deployments.
VITE_USE_MOCK_API=false

# Convex deployment auth + SMTP settings (set with `npx convex env set`, not here):
# SITE_URL=http://127.0.0.1:5273          # local dev frontend origin (also allows resume uploads from localhost:5273)
# SITE_URL=https://register.hackuta.org     # production frontend origin
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# CONTACT_EMAIL_TO=
